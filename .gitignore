*.pdb
*.ilk
*.idb
*.tlog
*.log
*.binlog

# Packaged / distributable binaries
*.exe
*.dll
*.lib
*.exp

# Test and coverage artifacts
TestResult*/
*.trx
coverage*.json
coverage*.xml
coverage*.info

# Python cache (utility scripts)
__pycache__/
*.pyc
