# Visual Studio and IDE state
.vs/
*.suo
*.user
*.userprefs
*.rsuser
*.sln.docstates

# Environment and local editor files
*.env
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
